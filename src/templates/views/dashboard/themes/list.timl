@include("tabs/navigation")

if $this["hasInvalidThemes"]:
  div.row.mb-2 > div.col-lg-12 > div.px-3
    div.alert.alert-warning.rounded-4.mb-0
      strong: "Unavailable themes detected. "
      span: "Fix or remove the affected theme directories, then refresh this page."

div.row.mb-2
  div.col-lg-12 > div.px-3
    div.row
      div.col-lg-5: "Theme"
      div.col-lg-2.text-center: "Status"
      div.col-lg-2.text-center: "Author"
div.row.g-3
  if len($this["themes"]) == 0:
    div.col-lg-12 > div.card.rounded-4.shadow-sm
      div.card-body.p-4.text-center.text-muted: "No themes match this filter."
  for $theme in $this["themes"]:
    const themeID = toString($theme["id"])
    div.col-lg-12 > div.card.rounded-4.shadow-sm.hover-effect data-card-id=$themeID
      div.card-body.p-4
        div.row
          div.col-lg-5
            h6.mb-1: $theme["name"]
            p.text-muted.mb-0.lh-sm.small: $theme["description"]
            ul.list-unstyled.d-flex.gap-3.mt-2.mb-0
              li.ms-1.text-muted.small
                span: $theme["version"]
              li.ms-1.text-muted.small
                span: $theme["license"]
            if len(toString($theme["error"])) > 0:
              p.text-warning.mb-0.mt-2.small: $theme["error"]
          div.col-lg-2.align-content-center.text-center
            if $theme["valid"]:
              if $theme["active"]:
                span.badge.rounded-pill.text-bg-success: "Active"
              else:
                span.badge.rounded-pill.text-bg-secondary: "Inactive"
            else:
              span.badge.rounded-pill.text-bg-warning: "Unavailable"
          div.col-lg-2.align-content-center.text-center
            span: $theme["author"]
          div.col-lg-3.text-center.align-content-center
            if $theme["valid"]:
              if $theme["active"]:
                form method="POST" action=dashboard("themes/manage")
                  input type="hidden" name="theme_id" value=$themeID
                  input type="hidden" name="action" value="deactivate"
                  input type="hidden" name="csrf" value=$this["csrfToken"]
                  button.btn.btn-sm.btn-outline-secondary.rounded-3.border-2 type="submit": "Deactivate"
              else:
                form method="POST" action=dashboard("themes/manage")
                  input type="hidden" name="theme_id" value=$themeID
                  input type="hidden" name="action" value="activate"
                  input type="hidden" name="csrf" value=$this["csrfToken"]
                  button.btn.btn-sm.btn-primary.rounded-3 type="submit": "Activate"
