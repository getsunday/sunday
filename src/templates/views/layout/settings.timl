@include("tabs/navigation")

macro renderField(field: json) =
  const name =
    if $field.hasKey("name") and len(toString($field["name"])) > 0: toString($field["name"])
    else: toString($field["model"])
  const fieldType =
    if $field.hasKey("field_type") and len(toString($field["field_type"])) > 0: toString($field["field_type"])
    else: "string"
  const label = toString($field["label"])
  const desc = toString($field["description"])
  const rawValue =
    if $this["values"].hasKey($name): toString($this["values"][$name])
    else: ""
  div.mb-3
    if $fieldType == "boolean":
      if $rawValue == "true" or $rawValue == "on" or $rawValue == "1":
        input.form-check-input type="checkbox" name=$name value="true" checked
        label.form-check-label: $label
      else:
        input.form-check-input type="checkbox" name=$name value="true"
        label.form-check-label: $label
    elif $fieldType == "text":
      label.form-label: $label
      textarea.form-control name=$name rows="4": $rawValue
    elif $fieldType == "integer" or $fieldType == "float" or $fieldType == "port":
      label.form-label: $label
      input.form-control type="number" name=$name value=$rawValue
    elif $fieldType == "password":
      label.form-label: $label
      input.form-control type="password" name=$name value="" autocomplete="new-password"
    else:
      label.form-label: $label
      input.form-control type="text" name=$name value=$rawValue
    if $this["fieldErrors"].hasKey($name):
      div.invalid-feedback.d-block: $this["fieldErrors"][$name]
    if len($desc) > 0:
      div.form-text: $desc

div.row > div.col-12
  form method="POST" action=dashboard("settings")
    input type="hidden" name="section" value=$this["section"]
    input type="hidden" name="csrf" value=$this["csrfToken"]
    if len($this["formErrors"]) > 0:
      div.alert.alert-danger
        ul.mb-0
          for $err in $this["formErrors"]:
            li: $err
    div.card.p-0.rounded-4
      div.p-4 > div.row
        for $node in $this["layout"]:
          if $node["type"] == "columns":
            div.row
              const colSize = 12 / $node["size"]
              for $col in $node["children"]:
                div class="col-lg-" & $colSize
                  for $item in $col["children"]:
                    @renderField($item)
          elif $node["type"] == "section":
            hr.my-4
            if len(toString($node["label"])) > 0:
              h5.h5.mb-0: $node["label"]
            for $child in $node["children"]:
              @renderField($child)
          elif $node["type"] == "field":
            @renderField($node)
          elif $node["type"] == "divider":
            hr.my-4
          elif $node["type"] == "alert":
            const alertStyle = toString($node["style"])
            if len($alertStyle) > 0:
              div class="alert alert-" & $alertStyle: $node["text"]
            else:
              div.alert.alert-info: $node["text"]
          elif $node["type"] == "card":
            div.card.p-0.rounded-4 > div.p-4
              for $child in $node["children"]:
                @renderField($child)
      div.sticky-bottom.rounded-bottom-4.py-3.mt-4.border-top.shadow-lg style="background-color: rgba(0, 0, 0, 0); backdrop-filter: blur(8px);"
        div.text-end.px-4
          button.btn.btn-dark.rounded-3 type="submit" name="settings_action" value="save": "Save Changes"
          for $node in $this["layout"]:
            if $node["type"] == "actions":
              for $btn in $node["children"]:
                const actionId =
                  if $btn.hasKey("id"): toString($btn["id"])
                  else: ""
                const btnLabel = toString($btn["label"])
                if len($btnLabel) > 0 and $actionId == "restoreDefaults":
                  const btnClass =
                    if $btn.hasKey("class") and len(toString($btn["class"])) > 0: toString($btn["class"])
                    else: "btn.btn-outline-info.rounded-3.ms-2"
                  button class=$btnClass type="submit" name="settings_action" value="restoreDefaults" onclick="return confirm('Restore default settings?')": $btnLabel
